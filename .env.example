# Copy to .env and fill in. .env is gitignored.
# The password is NOT stored here: write it to .secrets/pg_password, e.g.
#   mkdir -p .secrets && printf '%s' 'PASSWORD' > .secrets/pg_password && chmod 600 .secrets/pg_password

# External Postgres (LAN). The database must already exist (UTF8, owned by PG_USER).
PG_HOST=192.168.1.10
PG_PORT=5432
PG_USER=fleet_rental_dev
PG_DATABASE=fleet_rental_dev

# Optional
# EXTRA_ADDONS_PATH=/home/you/src/odoo_addons   # other addons the DB needs (e.g. muk_web_*)
# ODOO_PORT=8369
# ODOO_BIND=127.0.0.1   # set to 0.0.0.0 to reach Odoo from other machines on the LAN
