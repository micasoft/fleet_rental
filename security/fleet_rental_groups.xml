<?xml version="1.0" ?>
<odoo>
    <!-- Create the Category Car Rental Management -->
    <record id="module_car_rental" model="ir.module.category">
        <field name="name">Car Rental Management</field>
        <field name="sequence">20</field>
    </record>

    <!-- Group Dropoff/Pickup user(s) -->
    <record id="fleet_car_rental_group_limited" model="res.groups">
        <field name="name">Dropoff/Pickup User</field>
        <field name="category_id" ref="fleet_rental.module_car_rental"/>
    </record>

    <!--    Group Normal User(s)-->
    <record id="fleet_car_rental_group_user" model="res.groups">
        <field name="name">Normal User</field>
        <field name="category_id" ref="fleet_rental.module_car_rental"/>
        <field name="implied_ids" eval="[(4, ref('fleet_rental.fleet_car_rental_group_limited')),
                            (4, ref('base.group_user')),
                            (4, ref('fleet.fleet_group_user')),
                            (4, ref('account.group_account_invoice'))]"/>
    </record>

    <!--    Group Administrator User(s)-->
    <record id="fleet_car_rental_group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids"
               eval="[(4, ref('fleet_rental.fleet_car_rental_group_user'))]"/>
        <field name="category_id" ref="fleet_rental.module_car_rental"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>
</odoo>
