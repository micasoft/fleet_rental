<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- noupdate: databases keep their own (possibly edited) copies on update. -->
<data noupdate="1">
    <record id="mail_template_quote" model="mail.template">
        <field name="name">Car Rental: Quote</field>
        <field name="description">Sent to the customer with the quote of a booking</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="subject">Rental quote for {{ object.car_description or object.vehicle_id.name }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Brandon Freeman</t>,</p>
    <p>Thank you for contacting us! Here is our proposal:</p>
        <ul>
            <li>Pick-up: <t t-out="object.rent_start_date_locale or ''">01/03/2026 10:00</t>, <t t-out="object.pickup_location or ''">Lisbon Airport</t></li>
            <li>Return: <t t-out="object.rent_end_date_locale or ''">05/03/2026 10:00</t>, <t t-out="object.dropoff_location or ''">Hotel Yeatman</t></li>
            <li>Vehicle: <t t-out="object.car_description or object.vehicle_id.name or ''">Mercedes-Benz CLS</t></li>
            <li>Estimated cost: <t t-out="format_amount(object.total_cost, object.company_currency_id)">€ 5,000.00</t></li>
            <li>Deposit: <t t-out="format_amount(object.car_deposit, object.company_currency_id)">€ 1,000.00</t></li>
            <li>Your contact: <t t-out="object.sales_person.name or ''">Mitchell Admin</t><t t-if="object.sales_person.phone">, <t t-out="object.sales_person.phone">+351 999 999 999</t></t></li>
        </ul>
    <p>To book, just reply with a copy of your driving licence, your ID card or passport, and your address.</p>
    <p>If this is not quite what you are looking for, tell us: we have other options.</p>
        <p>Best regards,<br/>
            <t t-out="object.sales_person.name or object.company_id.name or ''">Mitchell Admin</t></p>
</div>
        </field>
    </record>

    <record id="mail_template_reserved" model="mail.template">
        <field name="name">Car Rental: Reservation</field>
        <field name="description">Sent to the customer when a booking is reserved</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="subject">Reservation {{ object.name }} for {{ object.car_description or object.vehicle_id.name }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Brandon Freeman</t>,</p>
    <p>Thank you for booking with us! Your reservation <strong t-out="object.name or ''">RENT/2026/0001</strong> is confirmed:</p>
        <ul>
            <li>Pick-up: <t t-out="object.rent_start_date_locale or ''">01/03/2026 10:00</t>, <t t-out="object.pickup_location or ''">Lisbon Airport</t></li>
            <li>Return: <t t-out="object.rent_end_date_locale or ''">05/03/2026 10:00</t>, <t t-out="object.dropoff_location or ''">Hotel Yeatman</t></li>
            <li>Vehicle: <t t-out="object.car_description or object.vehicle_id.name or ''">Mercedes-Benz CLS</t></li>
            <li>Estimated cost: <t t-out="format_amount(object.total_cost, object.company_currency_id)">€ 5,000.00</t></li>
            <li>Deposit: <t t-out="format_amount(object.car_deposit, object.company_currency_id)">€ 1,000.00</t></li>
            <li>Your contact: <t t-out="object.sales_person.name or ''">Mitchell Admin</t><t t-if="object.sales_person.phone">, <t t-out="object.sales_person.phone">+351 999 999 999</t></t></li>
        </ul>
    <p>To complete it, please send us a copy of your driving licence, your ID card or passport, and your address.</p>
    <p>On pick-up day, the deposit amount will be blocked on your credit card.</p>
    <p>Any question? Just reply to this e-mail.</p>
        <p>Best regards,<br/>
            <t t-out="object.sales_person.name or object.company_id.name or ''">Mitchell Admin</t></p>
</div>
        </field>
    </record>

    <record id="mail_template_recurring_reminder" model="mail.template">
        <field name="name">Car Rental: Recurring payment reminder</field>
        <field name="description">Sent to the customer for each recurring invoice</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="subject">Payment reminder for {{ object.name }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Brandon Freeman</t>,</p>
    <p>This is a reminder that a payment for your rental contract is due:</p>
    <ul>
        <li>Contract: <t t-out="object.name or ''">RENT/2026/0001</t></li>
        <li>Amount: <t t-out="format_amount(ctx.get('invoice').amount_total, ctx.get('invoice').currency_id) if ctx.get('invoice') else ''">€ 500.00</t></li>
        <li>Due date: <t t-out="format_date(ctx.get('invoice').invoice_date_due) if ctx.get('invoice') else ''">12/12/2026</t></li>
        <li>Your contact: <t t-out="object.sales_person.name or ''">Mitchell Admin</t><t t-if="object.sales_person.phone">, <t t-out="object.sales_person.phone">+351 999 999 999</t></t></li>
    </ul>
    <p>Do not hesitate to contact us if you have any question.</p>
        <p>Best regards,<br/>
            <t t-out="object.sales_person.name or object.company_id.name or ''">Mitchell Admin</t></p>
</div>
        </field>
    </record>

    <record id="mail_template_next_pickup" model="mail.template">
        <field name="name">Car Rental: Next pickup</field>
        <field name="description">Sent the day before to the person handling the pickup</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="partner_to">{{ object.handle_pickup.id }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_cc">{{ object.sales_person.email }}</field>
        <field name="subject">Pickup tomorrow: {{ object.name }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Hello <t t-out="object.handle_pickup.name or ''">Brandon Freeman</t>,</p>
    <p>Tomorrow you have a pickup for booking <strong t-out="object.name or ''">RENT/2026/0001</strong>:</p>
    <ul>
        <li>Pick-up: <t t-out="object.rent_start_date_locale or ''">01/03/2026 10:00</t> at <t t-out="object.pickup_location or ''">Lisbon Airport</t></li>
        <li>Drop-off: <t t-out="object.rent_end_date_locale or ''">05/03/2026 10:00</t> at <t t-out="object.dropoff_location or ''">Hotel Yeatman</t></li>
        <li>Vehicle: <t t-out="object.vehicle_id.name or ''">Mercedes-Benz CLS</t></li>
        <li>Customer: <t t-out="object.customer_id.name or ''">Brandon Freeman</t></li>
        <li>Deposit: <t t-out="format_amount(object.car_deposit, object.company_currency_id)">€ 1,000.00</t></li>
    </ul>
    <t t-if="object.line_tools">
        <p><strong>Accessories:</strong></p>
        <ul>
            <li t-foreach="object.line_tools" t-as="tool"><t t-out="tool.name.name">GPS</t></li>
        </ul>
    </t>
    <p t-if="object.notes"><strong>Notes:</strong> <t t-out="object.notes">Notes</t></p>
</div>
        </field>
    </record>

    <record id="mail_template_next_dropoff" model="mail.template">
        <field name="name">Car Rental: Next drop-off</field>
        <field name="description">Sent the day before to the person handling the drop-off</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="partner_to">{{ object.handle_dropoff.id }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_cc">{{ object.sales_person.email }}</field>
        <field name="subject">Drop-off tomorrow: {{ object.name }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Hello <t t-out="object.handle_dropoff.name or ''">Brandon Freeman</t>,</p>
    <p>Tomorrow you have a drop-off for booking <strong t-out="object.name or ''">RENT/2026/0001</strong>:</p>
    <ul>
        <li>Pick-up: <t t-out="object.rent_start_date_locale or ''">01/03/2026 10:00</t> at <t t-out="object.pickup_location or ''">Lisbon Airport</t></li>
        <li>Drop-off: <t t-out="object.rent_end_date_locale or ''">05/03/2026 10:00</t> at <t t-out="object.dropoff_location or ''">Hotel Yeatman</t></li>
        <li>Vehicle: <t t-out="object.vehicle_id.name or ''">Mercedes-Benz CLS</t></li>
        <li>Customer: <t t-out="object.customer_id.name or ''">Brandon Freeman</t></li>
        <li>Deposit: <t t-out="format_amount(object.car_deposit, object.company_currency_id)">€ 1,000.00</t></li>
    </ul>
    <t t-if="object.line_tools">
        <p><strong>Accessories:</strong></p>
        <ul>
            <li t-foreach="object.line_tools" t-as="tool"><t t-out="tool.name.name">GPS</t></li>
        </ul>
    </t>
    <p t-if="object.notes"><strong>Notes:</strong> <t t-out="object.notes">Notes</t></p>
</div>
        </field>
    </record>
</data>
</odoo>
