<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
<!--    Rental analysis: revenue per vehicle and month -->
        <record id="report_fleet_rental_view_pivot" model="ir.ui.view">
            <field name="name">report.fleet.rental.view.pivot</field>
            <field name="model">report.fleet.rental</field>
            <field name="arch" type="xml">
                <pivot string="Rental Analysis" disable_linking="1" sample="1">
                    <field name="vehicle_id" type="row"/>
                    <field name="rent_start_date" interval="month" type="col"/>
                    <field name="total_cost" type="measure"/>
                </pivot>
            </field>
        </record>
        <record id="report_fleet_rental_view_graph" model="ir.ui.view">
            <field name="name">report.fleet.rental.view.graph</field>
            <field name="model">report.fleet.rental</field>
            <field name="arch" type="xml">
                <graph string="Rental Analysis" type="bar" sample="1">
                    <field name="rent_start_date" interval="month"/>
                    <field name="total_cost" type="measure"/>
                </graph>
            </field>
        </record>
        <record id="action_fleet_rental_analysis" model="ir.actions.act_window">
            <field name="name">Rental Analysis</field>
            <field name="res_model">report.fleet.rental</field>
            <field name="view_mode">graph,pivot</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">No rental to analyse yet</p>
                <p>Revenue of the rentals per vehicle, customer and period.</p>
            </field>
        </record>
        <menuitem name="Rental Analysis" action="action_fleet_rental_analysis"
                  id="menu_fleet_rental_analysis" parent="fleet.menu_fleet_reporting"
                  sequence="1"/>
    </data>

</odoo>