<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="basic_layout" name="Default Fleet Rental layout">
    <t t-call="web.html_container">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div><![CDATA[&nbsp;]]></div>
            <t t-out="0"/>
            <div ><![CDATA[&nbsp;]]></div>
        </div>
    </t>
</template>

<template id="report_fleet_rental_contract">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="fleet_rental.basic_layout">
                <div class="page">
                    <style>
                        body {font-family: sans-serif;font-size: 12px;}
                        .dsection {border-color: gray;border-style: solid;padding: 3px;border-width: 1px; margin: 10px 0px}
                    </style>
                    <div>
                        <div style="width: 180px;float: right;text-align: center;border-color: gray;border-style: solid;padding: 10px;border-width: 1px">
                            <b>RENTAL CONTRACT</b><br/>
                            <span t-field="o.name"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>