<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservation PDF, on the company's document layout. -->
    <template id="report_fleet_rental_reserve">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Rental Reservation <span t-field="o.name"/></h2>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
