<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact form: identity papers and driving licence of individuals, and
         the rental flags, in their own page. -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view.partner.form.inherit.fleet.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="fleet_car_rental" string="Rental">
                    <group invisible="is_company">
                        <group name="identity" string="Identity">
                            <field name="person_id" placeholder="ID card or passport number"/>
                            <field name="person_id_issuer"/>
                            <field name="person_id_date"/>
                            <field name="person_id_until"/>
                            <field name="date_of_birth"/>
                            <field name="birthplace"/>
                        </group>
                        <group name="driving_licence" string="Driving Licence">
                            <field name="license" placeholder="Licence number"/>
                            <field name="license_issuer"/>
                            <field name="license_date"/>
                            <field name="license_until"/>
                        </group>
                    </group>
                    <group name="car_rental" string="Rental Settings">
                        <field name="employee" invisible="is_company"/>
                        <field name="is_agency" invisible="not is_company"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
