<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle form: a "Rental" page with the terms, the daily rates and the bookings. -->
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.view.form.inherit.fleet.rental</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_tax_info']" position="before">
                <page string="Rental" name="page_car_rental">
                    <group>
                        <group name="rental_terms" string="Terms">
                            <field name="owner" domain="[('is_company', '=', True)]"/>
                            <field name="deposit"/>
                            <field name="km_included_per_day"/>
                            <field name="km_extra"/>
                        </group>
                        <group name="rental_rates" string="Daily Rates">
                            <field name="rental_cost" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="day_from"/>
                                    <field name="day_to"/>
                                    <field name="cost_per_day"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <group name="rental_bookings" string="Bookings">
                        <field name="rental_reserved_time" nolabel="1" colspan="2" readonly="1">
                            <list default_order="date_to desc">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="customer_id"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
