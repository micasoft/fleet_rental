<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--   Car rental contract pickup list view  -->
    <record id="car_rental_contract_pickup_list" model="ir.ui.view">
        <field name="name">car.rental.contract.view.list</field>
        <field name="model">car.rental.contract</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="car_contract_result"
                default_order="rent_start_date desc">
                <field name="driver_id" string="Driver"/>
                <field name="vehicle_id"/>
                <field name="rent_start_date"/>
            </list>
        </field>
    </record>

    <!--    Car rental contract calendar view    -->
    <record id="car_rental_contract_pickup_calendar" model="ir.ui.view">
        <field name="name">car.rental.contract.calendar</field>
        <field name="model">car.rental.contract</field>
        <field name="arch" type="xml">
            <calendar string="Car Rental Reserved" mode="week" date_start="rent_start_date" date_stop="rent_end_date" color="state" event_limit="5" quick_create="0" create="1" delete="0">
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="pickup_location"/>
                <field name="dropoff_location"/>
                <field name="total_cost" widget="monetary"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <!--   Car rental contract pickup Form  -->
    <record id="car_rental_contract_pickup_form" model="ir.ui.view">
        <field name="name">car.rental.contract.pickup.form</field>
        <field name="model">car.rental.contract</field>
        <field name="arch" type="xml">
            <form string="My Model (Read Only)" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="id" />
                        <field name="state" readonly="1" />
                        <field name="rent_pickup_date" />
                        <field name="fuel_tunk_pickup" widget="progressbar" options="{'title': 'Fuel', 'max_value': 100.0, 'editable': true }"/>
                    </group>
                    <button name="action_save_pickup" type="object" string="Save Progress" class="btn-primary"/>
                </sheet>
            </form>
        </field>
    </record>

    <!--    Action rental Pickup-->
    <record id="action_car_rental_contract_pickup" model="ir.actions.act_window">
        <field name="name">Rental Pickup</field>
        <field name="res_model">car.rental.contract</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="view_ids"
        eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('car_rental_contract_pickup_list')}),
        (0, 0, {'view_mode': 'calendar', 'view_id': ref('car_rental_contract_pickup_calendar')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('car_rental_contract_pickup_form')})]" />

        <field name="domain">[('state','=','reserved')]</field>
        <!-- Restrict to specific group -->
        <field name="groups_id" eval="[(6, 0, [ref('fleet_rental.fleet_car_rental_group_limited')])]"/>
    </record>

    <menuitem id="menu_car_rental_contract_pickup" parent="menu_car_parent"
            name="Car Rental Pickup(s)" groups="fleet_rental.fleet_car_rental_group_limited"
            action="action_car_rental_contract_pickup" sequence="2"/>
</odoo>